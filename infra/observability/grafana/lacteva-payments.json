{
  "uid": "lacteva-payments",
  "title": "Lacteva \u2014 Payments & Receipts",
  "description": "Money movement and the artifacts that prove it.",
  "tags": [
    "lacteva"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Payments created / completed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(payments_created_total[15m])) by (method)",
          "legendFormat": "created {{method}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(payments_completed_total[15m])) by (method)",
          "legendFormat": "completed {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Payment failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(payments_failed_total[15m])) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(payments_cancelled_total[15m])) by (method)",
          "legendFormat": "cancelled {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Receipts generated",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(receipts_generated_total[15m]))",
          "legendFormat": "receipts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Receipt render p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(receipt_render_duration_seconds_bucket[15m])) by (le, format))",
          "legendFormat": "{{format}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Settlements",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(settlements_created_total[1h]))",
          "legendFormat": "created",
          "refId": "A"
        },
        {
          "expr": "sum(rate(settlements_finalized_total[1h]))",
          "legendFormat": "finalized",
          "refId": "B"
        },
        {
          "expr": "sum(rate(settlements_cancelled_total[1h]))",
          "legendFormat": "cancelled",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
