# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Environments & secrets
.env
.env.*
!.env.example
# DEP-001: the production TEMPLATE is committed (it documents every variable
# and contains only placeholders); the filled-in file never is.
!.env.production.example

# Node / Next.js (admin portal)
node_modules/
.next/
out/

# Flutter (mobile app)
.dart_tool/
build/
.flutter-plugins*

# IDE / OS
.idea/
.vscode/
.DS_Store

# Local data
*.sqlite3
minio-data/

# Claude Code local settings
.claude/

# INF-001: Terraform state holds resource ids and can hold secrets; tfvars
# holds credentials. The .example files are committed, the real ones never.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# PORTAL-001 / F-05 — mobile release signing material. NEVER committed.
# The keystore is a permanent credential: losing it means the app can never
# be upgraded, and leaking it means anyone can publish as us.
apps/mobile/android/key.properties
*.jks
*.keystore
!apps/mobile/android/key.properties.example
