# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Environments & secrets
.env
.env.*
!.env.example
# DEP-001: the production TEMPLATE is committed (it documents every variable
# and contains only placeholders); the filled-in file never is.
!.env.production.example
# WO-77: the Firebase service-account key can push to every handset in the
# project. It lives on the host at /etc/lacteva/fcm-service-account.json and
# nowhere in this tree; `tools/validate/check_secrets.py` fails the build if
# its contents appear anywhere. `google-services.json` is NOT a secret (it
# ships inside every APK) and is committed on purpose.
*fcm-service-account*.json
*firebase-adminsdk*.json

# Node / Next.js (admin portal)
# No trailing slash: a symlink or a file of that name is covered too (D-45 review).
node_modules
.next/
out/

# Flutter (mobile app)
.dart_tool/
build/
.flutter-plugins*

# IDE / OS
.idea/
.vscode/
.DS_Store

# Local data
*.sqlite3
minio-data/

# Claude Code local settings
.claude/

# INF-001: Terraform state holds resource ids and can hold secrets; tfvars
# holds credentials. The .example files are committed, the real ones never.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# PORTAL-001 / F-05 — mobile release signing material. NEVER committed.
# The keystore is a permanent credential: losing it means the app can never
# be upgraded, and leaking it means anyone can publish as us.
apps/mobile/android/key.properties
*.jks
*.keystore
!apps/mobile/android/key.properties.example
