# Where "Request a demo" submissions are forwarded, server-side, at request
# time (e.g. a CRM or form-relay webhook). Unset => the API answers 503 and
# the form shows its fallback message. Never expose via NEXT_PUBLIC_*.
LACTEVA_LEADS_WEBHOOK_URL=

# Public URL of the authenticated admin portal. When set, the header shows a
# "Sign in" link pointing at it. Public by nature, hence NEXT_PUBLIC_.
NEXT_PUBLIC_PORTAL_URL=

# Canonical origin of this site, used for metadata/sitemap/robots.
# Placeholder domain until the public domain is a commercial decision.
LACTEVA_SITE_URL=https://lacteva.example
