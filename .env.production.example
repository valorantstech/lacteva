# Lacteva — production environment (DEP-001).
#
#   cp .env.production.example .env.production
#
# EVERY value below is a placeholder. Nothing here is a working credential and
# nothing here may become one: this file is committed. `.env.production` is
# not, and `.gitignore` enforces that.
#
# Two ways to supply a secret, and they compose:
#
#   1. This file, read by compose as `env_file`. Simple; the value is visible
#      to `docker inspect` and to any child process's environment.
#   2. Docker Secrets, mounted at /run/secrets/<name>. The application reads
#      them through pydantic-settings' `secrets_dir`, so a file named
#      `lacteva_jwt_keys` sets `LACTEVA_JWT_KEYS` without it ever appearing in
#      an environment block. Prefer this for anything that signs or decrypts.
#      See DEPLOYMENT.md §Secrets.
#
# A variable set in BOTH places resolves to the environment value, which makes
# a local override easy and an accidental one easy to miss — check the deploy
# log's `settings_loaded` line if a value is not what you expect.

# =============================================================================
# APPLICATION
# =============================================================================

# The image to run. Deployments are PINNED — never `:latest`. This one
# variable is what a rollback changes, so it must identify a build exactly
# (a git SHA, not a moving tag).
LACTEVA_IMAGE=lacteva/platform-core
LACTEVA_IMAGE_TAG=CHANGEME-git-sha

# Refuses to start on a development credential, disables the Swagger UI, and
# turns on the production security posture. Only `prod` does all three.
LACTEVA_ENV=prod

# Structured JSON logs at this level. `DEBUG` in production will log request
# bodies through the audit path — do not.
LACTEVA_LOG_LEVEL=INFO

# Uvicorn worker processes. Rule of thumb: (2 x cores) + 1, then check that
# API_WORKERS x (pool_size + max_overflow) stays under POSTGRES_MAX_CONNECTIONS.
API_WORKERS=4

# Seconds uvicorn spends draining in-flight requests on SIGTERM, before the
# lifespan shutdown runs. Must be less than the compose `stop_grace_period`
# (90s) minus LACTEVA_SHUTDOWN_GRACE_SECONDS.
API_GRACEFUL_TIMEOUT=30

# Seconds background workers get to finish the unit of work they are in.
# Longer than a poll interval by a wide margin; shorter than what is left of
# the container's stop grace after the request drain.
LACTEVA_SHUTDOWN_GRACE_SECONDS=20

# Hard memory ceiling for the API container.
API_MEMORY_LIMIT=1g

# Exact origins allowed to call the API from a browser. A JSON list, never a
# wildcard — `allow_credentials` with a wildcard is refused by browsers, and
# reflecting the request origin would defeat the point of a list.
LACTEVA_CORS_ORIGINS=["https://admin.example.com"]

# Ports nginx publishes on the host. The only ports this stack exposes.
HTTP_PORT=80
HTTPS_PORT=443

# Directory holding fullchain.pem and privkey.pem, mounted read-only into
# nginx. Point this at the certbot live directory in a real deployment.
TLS_CERT_DIR=./infra/nginx/certs

# =============================================================================
# DATABASE
# =============================================================================

# The database URL is ASSEMBLED by compose from these three, so the credential
# appears in exactly one place. Do not set LACTEVA_DATABASE_URL directly here.
POSTGRES_USER=lacteva
POSTGRES_PASSWORD=CHANGEME-strong-random-password
POSTGRES_DB=lacteva

# Server major version. Both 16 and 17 are verified by the PostgreSQL
# Verification workflow; 16 is the documented baseline (DBD-0001).
POSTGRES_VERSION=16

# Must exceed API_WORKERS x (SQLAlchemy pool_size + max_overflow) plus the
# background workers, plus headroom for an operator to connect during an
# incident. Exhausting this makes NEW connections fail, including yours.
POSTGRES_MAX_CONNECTIONS=200

# Roughly 25% of the host's RAM.
POSTGRES_SHARED_BUFFERS=512MB

# Per sort node, per connection — so the real multiplier is large. Raising
# this is the standard way to run a database out of memory.
POSTGRES_WORK_MEM=16MB

# Governs index build and VACUUM speed on the large tables. At the default
# 64MB, a CREATE INDEX on a billion-row table is unreasonably slow.
POSTGRES_MAINTENANCE_WORK_MEM=1GB

# Milliseconds. A backstop for connections made by hand; the application sets
# its own, tighter timeout. An unbounded query holds its snapshot and blocks
# vacuum across the whole database.
POSTGRES_STATEMENT_TIMEOUT=120000

# =============================================================================
# REDIS
# =============================================================================

# Rate-limit counters. Redis is not published outside the compose network, but
# a password is still required — an unauthenticated Redis on any reachable
# network is a remote code execution waiting to happen.
REDIS_PASSWORD=CHANGEME-strong-random-password

# Eviction ceiling. The limiter fails open by design, so a lost counter costs
# accuracy, never a request.
REDIS_MAXMEMORY=512mb

# =============================================================================
# JWT / SIGNING
# =============================================================================

# RS256 in production. HS256 exists only as a rollback path and is refused
# when LACTEVA_ENV=prod.
LACTEVA_JWT_ALGORITHM=RS256

# The key registry as JSON: a list of {kid, private_pem, public_pem, status}.
# Rotation is ADDITIVE — add the new key as `current`, leave the old one as
# `retiring` until every issued token has expired, then remove it.
#
# STRONGLY prefer a Docker Secret for this. A private signing key in an
# `env_file` is visible to `docker inspect` and to every child process.
#   docker secret create lacteva_jwt_keys ./keys.json
LACTEVA_JWT_KEYS=<CHANGEME-see-docs/03-architecture/05-security/JWT-ROTATION.md>

# Access tokens are short because revocation is session-based; refresh tokens
# carry the real lifetime and rotate on every use.
LACTEVA_JWT_ACCESS_TTL_SECONDS=900
LACTEVA_JWT_REFRESH_TTL_SECONDS=1209600

# =============================================================================
# AWS
# =============================================================================
# Object storage for supplier documents. The platform speaks S3 through MinIO's
# client, so either MinIO or S3 works.
#
# On EC2/ECS/EKS, leave the key variables EMPTY and attach an instance role —
# ambient credentials cannot leak through this file.

AWS_REGION=eu-west-1
LACTEVA_MINIO_ENDPOINT=s3.eu-west-1.amazonaws.com
LACTEVA_MINIO_SECURE=true
LACTEVA_MINIO_ACCESS_KEY=
LACTEVA_MINIO_SECRET_KEY=<CHANGEME-or-use-an-instance-role>

# The AWS profile this platform deploys with, for tooling run outside the
# containers (Terraform, the AWS CLI, backup scripts).
AWS_PROFILE=ibs

# =============================================================================
# SMTP  (email delivery)
# =============================================================================
# NOT YET WIRED. NOT-001 ships logging and placeholder providers only — no
# email leaves the platform today, whatever is configured here. These
# variables exist so the deployment is ready when an adapter lands, and so
# nobody believes email is working because the settings look complete.

LACTEVA_NOTIFICATION_EMAIL_PROVIDER=logging
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=<CHANGEME-when-an-adapter-exists>
# Envelope sender. Must be a domain the SMTP relay is authorised to send for,
# or every message is silently classed as spam.
SMTP_FROM_ADDRESS=no-reply@example.com

# STARTTLS on the submission port. There is no reason to turn this off.
SMTP_USE_TLS=true

# =============================================================================
# SMS  (MSG-001 — this is now WIRED)
# =============================================================================
# Suppliers are reached by SMS. Until MSG-001 the platform rendered every
# message and handed it to a provider that discarded it; a farmer was never
# told they had been paid. That is closed.
#
# Modes:
#   logging      delegates to the notifier port and logs. Dev default
#   placeholder  accepts and discards — "no gateway configured yet"
#   dry_run      renders and logs a REAL message against production-shaped
#                configuration WITHOUT sending. Use this in staging: a
#                credential or sender-id mistake surfaces before a farmer
#                sees it
#   http         the gateway
#   disabled     refuses PERMANENTLY, for a market that is not live. Raises
#                rather than silently succeeding, because a notification
#                marked sent that was never sent is a lie
LACTEVA_NOTIFICATION_SMS_PROVIDER=http

# The gateway endpoint. The adapter is vendor-neutral: it posts
# {to, from, text, client_reference} and classifies the outcome by HTTP
# status, which every gateway agrees on. A gateway needing a different shape
# implements ChannelProvider and is registered at startup — see
# docs/03-architecture/04-technology-layer/NOTIFICATION-ENGINE.md.
LACTEVA_SMS_API_URL=https://sms.example.com/v1/messages

# Sent as `Authorization: Bearer`. STRONGLY prefer a Docker secret
# (/run/secrets/lacteva_sms_api_key) — an SMS credential in an env file is
# visible to `docker inspect`, and it can spend money.
LACTEVA_SMS_API_KEY=<CHANGEME-or-use-a-docker-secret>

# The sender a supplier sees. Registration is per-market and per-operator; a
# wrong value is rejected by the gateway as a PERMANENT failure, which is
# exactly why it is worth proving in dry-run first.
LACTEVA_SMS_SENDER_ID=LACTEVA

# Below a farmer's patience, above a gateway's p99. Too short and every
# message retries; too long and the consumer loop stalls behind one
# unresponsive gateway. A timeout is retried — safely, because every send
# carries a stable idempotency key the gateway deduplicates on.
LACTEVA_SMS_TIMEOUT_SECONDS=10

# =============================================================================
# MONITORING
# =============================================================================

# Grafana's admin login. Change it before the first start: Grafana creates the
# admin user on first boot and ignores this variable afterwards.
GRAFANA_ADMIN_PASSWORD=CHANGEME-strong-random-password

# Public URL Grafana builds links with. Wrong values break alert links in a
# way that is only noticed during an incident.
GRAFANA_ROOT_URL=https://grafana.example.com

# How long Prometheus keeps samples locally. Longer needs remote write.
PROMETHEUS_RETENTION=30d

# OpenTelemetry collector endpoint. Empty disables tracing entirely; the
# platform instruments the HTTP and consumer seams only (OBS-001).
LACTEVA_OTEL_EXPORTER_ENDPOINT=
