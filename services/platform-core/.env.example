# Lacteva platform-core environment (LACTEVA_ prefix; see core/config.py).
# Copy to .env for local development; NEVER commit real secrets.

LACTEVA_ENV=dev                    # dev | test | staging | prod
LACTEVA_LOG_LEVEL=INFO
LACTEVA_DEBUG=false

# Security — MUST be overridden outside dev; service refuses to start in prod with the dev default.
LACTEVA_JWT_SECRET=dev-secret-change-me
LACTEVA_JWT_ACCESS_TTL_SECONDS=900
LACTEVA_JWT_REFRESH_TTL_SECONDS=1209600

# Data stores (docker-compose service names as hosts)
LACTEVA_DATABASE_URL=postgresql+asyncpg://lacteva:lacteva@postgres:5432/lacteva
LACTEVA_REDIS_URL=redis://redis:6379/0

# Messaging / storage / search
LACTEVA_RABBITMQ_URL=amqp://lacteva:lacteva@rabbitmq:5672/
LACTEVA_EVENT_BUS=rabbitmq         # rabbitmq | memory | null
LACTEVA_MINIO_ENDPOINT=minio:9000
LACTEVA_MINIO_ACCESS_KEY=lacteva
LACTEVA_MINIO_SECRET_KEY=lacteva-secret
LACTEVA_MINIO_SECURE=false
LACTEVA_OPENSEARCH_URL=http://opensearch:9200

# Observability
LACTEVA_SERVICE_NAME=platform-core
LACTEVA_OTEL_EXPORTER_ENDPOINT=    # empty = OpenTelemetry export disabled (hook only)
